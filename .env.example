# Copy this file to .env in the repo root and fill in real values.
# Every prototype's backend reads from that single root .env.

# Google AI Studio key, used for text generation (and images when the account
# has image quota). Get one at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter key, used as the image-generation provider when the Google key has
# no image quota. Needs credit at https://openrouter.ai/settings/credits
OPENROUTER_API_KEY=

# Optional: override which OpenRouter model draws the frames.
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
